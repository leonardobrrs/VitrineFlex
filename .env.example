# VitrineFlex — Environment Configuration Template
ENVIRONMENT=development

# API Gateway
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000

# Auth Service
AUTH_SERVICE_HOST=0.0.0.0
AUTH_SERVICE_PORT=8001
AUTH_SERVICE_URL=http://localhost:8001

# Services URLs (Sprint 1 uses Gateway and Auth; others mapped for diagnostics)
LPS_CONFIG_SERVICE_URL=http://localhost:8002
CATALOG_SERVICE_URL=http://localhost:8003
CART_SERVICE_URL=http://localhost:8004
ORDERS_SERVICE_URL=http://localhost:8005
PAYMENTS_SERVICE_URL=http://localhost:8006
SHIPPING_SERVICE_URL=http://localhost:8007
RECOMMENDATION_SERVICE_URL=http://localhost:8008

# Security & Tokens (ADR-007)
JWT_SECRET_KEY=dev-jwt-secret-key-vitrineflex-ufal-2026-very-secure
INTERNAL_SERVICE_KEY=dev-internal-service-token-vitrineflex-ufal-2026

# Persistence (ADR-005: SQLite WAL)
DB_STORAGE_DIR=./data
